# ==============================================================================
# Job Operating System - Environment Configuration
# ₹0, 100% Local, Strict F: Drive Architecture
# ==============================================================================

# Application Environment (development | local_production | test)
APP_ENV=local_production
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_local_secret_key_32_chars

# Server Binding
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Local PostgreSQL Configuration
# Dedicated Application User (Created non-destructively by database/init_db.py)
DATABASE_URL=postgresql://job_agent_user:your_secure_local_password_here@localhost:5432/job_agent_db
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/job_agent_test_db

# Mandatory F: Drive Storage & Cache Paths
WORKSPACE_ROOT=F:\job wala project
STORAGE_DIR=F:\job wala project\storage
DOCUMENTS_DIR=F:\job wala project\storage\documents
LOG_DIR=F:\job wala project\logs
TMP_DIR=F:\job wala project\tmp
CACHE_DIR=F:\job wala project\.cache

# Playwright Browser Engine Isolation (Prevents spillover into C:\Users\...)
PLAYWRIGHT_BROWSERS_PATH=F:\job wala project\.cache\ms-playwright
PLAYWRIGHT_HEADLESS=true
BROWSER_DATA_DIR=F:\job wala project\storage\browser_sessions
BROWSER_TIMEOUT_MS=30000

# Step 12 Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_BATCH_SIZE=5
WORKER_LEASE_TIMEOUT_SECONDS=300

# Step 12 Scheduler Configuration (Conservative)
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_DEFAULT_DISCOVERY_INTERVAL_HOURS=6
SCHEDULER_STALE_JOB_THRESHOLD_DAYS=30
